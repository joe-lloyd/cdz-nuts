[Unit]
Description=Music app containers after myCloud artwork mount
Requires=docker.service mnt-myCloud.mount
After=docker.service mnt-myCloud.mount

[Service]
Type=oneshot
RemainAfterExit=yes
User=pi-admin
WorkingDirectory=/home/pi-admin/cdz-nuts/apps/server
ExecStartPre=/usr/bin/mountpoint -q /mnt/myCloud
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop

[Install]
WantedBy=multi-user.target
